.container {
  position: relative;
  height: 100%;
  width: 100%;
  background-color: #f8fafc;
  overflow: hidden;
  font-family: 'Tajawal', sans-serif;
}

.canvasWrapper {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  cursor: crosshair;
  touch-action: none;
}

/* Background Types */
.blank { background-color: white; }
.ruled {
  background-color: white;
  background-image: linear-gradient(#e2e8f0 1px, transparent 1px);
  background-size: 100% 40px;
}
.grid {
  background-color: white;
  background-image: linear-gradient(#e2e8f0 1px, transparent 1px), linear-gradient(90deg, #e2e8f0 1px, transparent 1px);
  background-size: 40px 40px;
}

/* Floating Glass Panels */
.glassPanel {
  position: absolute;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(226, 232, 240, 0.8);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  z-index: 10;
  display: flex;
  padding: 8px;
  gap: 8px;
  transition: all 0.3s ease;
}

.bottomToolbar {
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  flex-direction: row;
  align-items: center;
}

.leftToolbar {
  top: 50%;
  left: 20px;
  transform: translateY(-50%);
  flex-direction: column;
}

.topRightToolbar {
  top: 20px;
  right: 20px;
  flex-direction: column;
  gap: 15px;
  min-width: 250px;
  padding: 15px;
}

.topLeftToolbar {
  top: 20px;
  left: 20px;
  flex-direction: row;
}

/* Buttons */
.toolBtn {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  color: #475569;
  transition: all 0.2s;
  position: relative;
}

.toolBtn:hover {
  background: #f1f5f9;
  color: #0f5132;
}

.activeTool {
  background: #ecfdf5;
  color: #059669;
  border: 1px solid #a7f3d0;
}

/* Dropdown/Popup Menus */
.popupMenu {
  position: absolute;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 10px;
  z-index: 20;
}

.popupMenuGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

/* Colors */
.colorsGroup {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.colorBtn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid white;
  box-shadow: 0 0 0 1px #cbd5e1;
  cursor: pointer;
  transition: transform 0.2s;
}

.colorBtn:hover { transform: scale(1.1); }
.activeColor { box-shadow: 0 0 0 2px #0f5132; transform: scale(1.1); }

/* Range */
.rangeInput { width: 100%; accent-color: #059669; }
.selectInput {
  width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; font-family: inherit;
}

/* Action Buttons */
.actionBtn {
  width: 100%; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; border: none; background: #f1f5f9; color: #475569; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: inherit;
}
.actionBtn:hover { background: #e2e8f0; }

.primaryBtn { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
.primaryBtn:hover { background: #dbeafe; }
.dangerBtn { background: #fee2e2; color: #ef4444; border: 1px solid #fecaca; }
.dangerBtn:hover { background: #fecaca; }

/* Sticky Note specific */
.stickyNoteItem {
  width: 40px; height: 40px; border-radius: 0 0 10px 0; border: 1px solid rgba(0,0,0,0.1); cursor: pointer; box-shadow: 2px 2px 5px rgba(0,0,0,0.1); transition: transform 0.2s;
}
.stickyNoteItem:hover { transform: scale(1.1); }

/* Icons Library Panel */
.libraryPanel {
  position: absolute;
  left: 80px;
  top: 50%;
  transform: translateY(-50%);
  width: 320px;
  max-height: 80vh;
  overflow-y: auto;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 15px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  z-index: 15;
}

.librarySection h5 { margin: 0 0 10px 0; color: #64748b; font-size: 0.9rem; }
.libraryGrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 20px; }
.libraryItem {
  display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px 5px; background: #f8fafc; border-radius: 8px; cursor: pointer; border: 1px solid transparent; transition: all 0.2s; color: #334155;
}
.libraryItem:hover { background: #f1f5f9; border-color: #cbd5e1; color: #0f5132; }
.libraryItem span { font-size: 0.7rem; margin-top: 5px; text-align: center; font-weight: 500; }

/* Tooltip */
.tooltip {
  position: absolute; bottom: calc(100% + 5px); left: 50%; transform: translateX(-50%); background: #334155; color: white; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.2s; margin-bottom: 0px; font-weight: normal; z-index: 50;
}
.toolBtn:hover .tooltip { opacity: 1; }

.leftToolbar .tooltip {
  bottom: 50%; left: calc(100% + 10px); transform: translateY(50%);
}

.advancedToolsContainer {
  position: absolute;
  bottom: 20px;
  right: 20px;
  display: flex;
  gap: 10px;
  z-index: 10;
}

.mobileOnly {
  display: none !important;
}

/* MOBILE LAYOUT */
@media (max-width: 768px) {
  .mobileOnly { display: flex !important; }
  .mobileHidden { display: none !important; }

  /* Universal Mobile Toolbar Styles */
  .topLeftToolbar, .topRightToolbar, .advancedToolsContainer, .leftToolbar, .bottomToolbar {
    padding: 4px 6px !important;
    gap: 6px !important;
    width: max-content !important;
    max-width: 95vw !important;
    flex-direction: row !important;
    justify-content: flex-start !important;
    left: 50% !important;
    right: auto !important;
    transform: translateX(-50%) !important;
    border-radius: 12px !important;
  }
  .leftToolbar, .bottomToolbar, .advancedToolsContainer {
    overflow-x: auto !important;
    flex-wrap: nowrap !important;
    scrollbar-width: none !important;
  }
  .topLeftToolbar, .topRightToolbar {
    overflow: visible !important;
    flex-wrap: wrap !important;
  }
/* 1. Pages (Top Centered) */
  .topLeftToolbar { top: 10px !important; bottom: auto !important; z-index: 40 !important; }

  /* 2. Zoom, Timer (Bottom Row 4) */
  .advancedToolsContainer { 
    bottom: 160px !important; top: auto !important; z-index: 39 !important; display: flex !important; background: rgba(255, 255, 255, 0.9) !important; backdrop-filter: blur(10px) !important; border: 1px solid rgba(226, 232, 240, 0.8) !important; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05) !important;
  }

  /* 3. Settings & Colors (Bottom Row 3) */
  .topRightToolbar { bottom: 110px !important; top: auto !important; z-index: 38 !important; min-width: unset !important; align-items: center !important;
  }

  /* 4. Drawing Tools (Bottom Row 2) */
  .leftToolbar { 
    bottom: 60px !important; top: auto !important; z-index: 37 !important; 
  }

  /* 5. Insertion Tools (Bottom Row 1) */
  .bottomToolbar { 
    bottom: 10px !important; top: auto !important; z-index: 36 !important; 
  }

  /* Tooltips on mobile should appear above */
  .leftToolbar .tooltip { bottom: calc(100% + 6px) !important; left: 50% !important; transform: translateX(-50%) !important; }

  /* Button Sizing for Mobile (Comfortable for touch) */
  .toolBtn { width: 36px !important; height: 36px !important; flex-shrink: 0 !important; font-size: 12px !important; border-radius: 8px !important; }
  .toolBtn svg { width: 18px !important; height: 18px !important; }
  
  /* Colors */
  .colorsGroup { flex-direction: row !important; gap: 6px !important; flex-wrap: nowrap !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch !important; scrollbar-width: none !important; max-width: 220px !important; padding: 2px !important; }
  .colorBtn { width: 24px !important; height: 24px !important; flex-shrink: 0 !important; border-width: 1px !important; }
  
  .libraryPanel { left: 50% !important; top: 50% !important; transform: translate(-50%, -50%) !important; width: 95vw !important; max-width: 320px !important; }
}




